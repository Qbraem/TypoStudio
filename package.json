{
  "name": "studio-typo",
  "version": "1.0.0",
  "private": true,
  "description": "Studio Typo \u2013 transparent typography PNGs for social Stories (web + iOS app)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "ios:setup": "bash scripts/ios-setup.sh",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/core": "latest",
    "@capacitor/ios": "latest",
    "@capacitor/filesystem": "latest",
    "@capacitor/share": "latest",
    "@capacitor/haptics": "latest",
    "@capacitor/status-bar": "latest",
    "@capacitor/splash-screen": "latest",
    "@capacitor-community/media": "latest",
    "@revenuecat/purchases-capacitor": "latest",
    "@capacitor/geolocation": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest"
  }
}
